{
  "name": "@scayle/panel-icons",
  "version": "4.9.0",
  "description": "All the Panel icons you know and love",
  "homepage": "https://www.scayle.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scayle/panel-icons"
  },
  "devDependencies": {
    "@vue/compiler-dom": "~3.4.38",
    "beachball": "^2.47.1",
    "svgo": "^3.3.2",
    "typescript": "^5.9.3",
    "vue": "~3.4.38"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "files": [
    "icons/*",
    "CHANGELOG.json",
    "CHANGELOG.md",
    "index.js",
    "README.md",
    "vue/"
  ],
  "keywords": [
    "scayle",
    "scayle panel",
    "panel",
    "scayle panel icons",
    "panel icons"
  ],
  "scripts": {
    "build": "svgo -f ./raw -o ./icons --config svgo.config.js --exclude \"marketplace-\"",
    "build:vue": "node scripts/build-vue.js",
    "prepack": "node scripts/build-vue.js",
    "change": "beachball change --no-commit --package=@scayle/panel-icons",
    "checkchange": "beachball check",
    "release": "beachball publish --access public",
    "test": "npm run build:vue && node --test --test-concurrency=1 'test/*.test.js'"
  },
  "prettier": {
    "overrides": [
      {
        "files": "package.json",
        "options": {
          "tabWidth": 2
        }
      }
    ]
  }
}
